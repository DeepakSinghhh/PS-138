# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data (large / licensed files are dropped here by the user)
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# Model artifacts
backend/artifacts/*
!backend/artifacts/.gitkeep
!backend/artifacts/fuel_surrogate.json
!backend/artifacts/qphys_meta.json
!backend/artifacts/qphys.joblib

# Node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Local Claude Code settings
.claude/settings.local.json
frontend/tsconfig.tsbuildinfo

# Benchmark checkpoints (rewritten during a run)
reports/*.partial.json

# demo video build intermediates
tools/demo_video/frames/
tools/demo_video/timeline.json
tools/demo_video/frames.ffconcat
tools/demo_video/*.mp4
tools/demo_video/*.srt
tools/demo_video/*_voiceover.md
